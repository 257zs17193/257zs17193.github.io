  section#history.section.section-gray
    .container
      h2.section-title History
      .table-responsive
        table.btob-table.timeline-table
          tr
            th 2025年 4月
            td
              | 学校法人日本財団ドワンゴ学園 
              a(href="https://zen.ac.jp/" target="_blank") ZEN大学 
              i.bi.bi-box-arrow-up-right
              |  入学
          tr
            th 2022年 4月~現在
            td
              strong IT関連業務に従事
              br
              span.text-small 企画、設計～開発～保守を行う。自社製品に加え、新製品開発・受託業務も行う。
          tr
            th 2017年 4月~2022年 3月
            td
              strong 高等専門学校　在学
              br
              span.text-small ・電気電子系、経営を学ぶ
              br
              span.text-small ・部活動(少林寺拳法部、ボランティア同好会など)では部長をつとめる
              br
              span.text-small ・経営系のコンテストで審査員賞など受賞

  section#contact.section
    .container
      h2.section-title Contact
      p.section-lead ご相談・お問い合わせはこちらから
      .contact-card
        button#contact-link.btn.btn-primary(type="button") 連絡先を表示

  script.
    document.addEventListener('DOMContentLoaded', function() {
      // 紅茶ボタンの処理
      const teaBtn = document.getElementById('tea-btn');
      if (teaBtn) {
        teaBtn.addEventListener('click', function() {
          alert('ルピシアの店舗限定紅茶がおすすめです');
        });
      }

      // ハンバーグボタンの処理
      const hamburgBtn = document.getElementById('hamburg-btn');
      if (hamburgBtn) {
        hamburgBtn.addEventListener('click', function() {
          const result = confirm('今夜の夕飯はハンバーグで決まりですか？');
          if (result) {
            alert('ぜひ最寄りのびっくりドンキーへ！');
          } else {
            alert('残念です。');
          }
        });
      }

      // Contactボタンの処理
      const contactLink = document.getElementById('contact-link');
      if (contactLink) {
        contactLink.addEventListener('click', function() {
          alert('連絡先メールアドレス:257zs17193@student.zen.ac.jp ');
        });
      }

      // チャットボット関連
      const chatbotContainer = document.getElementById('chatbot-container');
      const chatbotToggle = document.getElementById('chatbot-toggle');
      const chatbotOpenBtn = document.getElementById('chatbot-open-btn');
      const chatbotMessages = document.getElementById('chatbot-messages');
      const chatbotInput = document.getElementById('chatbot-input');
      const chatbotSend = document.getElementById('chatbot-send');

      // チャットボットの開閉
      chatbotOpenBtn.addEventListener('click', function() {
        chatbotContainer.classList.toggle('open');
        chatbotOpenBtn.style.display = chatbotContainer.classList.contains('open') ? 'none' : 'flex';
      });

      chatbotToggle.addEventListener('click', function() {
        chatbotContainer.classList.remove('open');
        chatbotOpenBtn.style.display = 'flex';
      });

      // メッセージ送信
      function sendMessage() {
        const message = chatbotInput.value.trim();
        if (!message) return;

        // ボタンを無効化
        chatbotSend.disabled = true;
        chatbotSend.classList.add('sending');
        chatbotInput.disabled = true;

        // ユーザーメッセージを表示
        addMessageToChat('user', message);
        chatbotInput.value = '';

        // ボットがタイピング中の表示
        addTypingIndicator();

        // ボットの応答を取得（クライアント側で処理）
        const botReply = getBotResponse(message);
        
        // 応答を遅延させてより自然に見せる
        setTimeout(() => {
          removeTypingIndicator();
          addMessageToChat('bot', botReply);
          
          // ボタンを有効化
          chatbotSend.disabled = false;
          chatbotSend.classList.remove('sending');
          chatbotInput.disabled = false;
          chatbotInput.focus();
        }, 800);
      }

      function addTypingIndicator() {
        const msgDiv = document.createElement('div');
        msgDiv.className = 'chatbot-message bot typing-indicator';
        msgDiv.id = 'typing-indicator';
        msgDiv.innerHTML = '<span></span><span></span><span></span>';
        chatbotMessages.appendChild(msgDiv);
        chatbotMessages.scrollTop = chatbotMessages.scrollHeight;
      }

      function removeTypingIndicator() {
        const typingIndicator = document.getElementById('typing-indicator');
        if (typingIndicator) {
          typingIndicator.remove();
        }
      }

      function addMessageToChat(sender, text) {
        const msgDiv = document.createElement('div');
        msgDiv.className = `chatbot-message ${sender}`;
        msgDiv.textContent = text;
        chatbotMessages.appendChild(msgDiv);
        chatbotMessages.scrollTop = chatbotMessages.scrollHeight;
      }

      chatbotSend.addEventListener('click', sendMessage);
      chatbotInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') sendMessage();
      });

      // 推奨質問テンプレートのイベントリスナー
      const templateBtns = document.querySelectorAll('.template-btn');
      templateBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const question = this.getAttribute('data-question');
          chatbotInput.value = question;
          chatbotInput.focus();
        });
      });

      // Works セクションのタグフィルタリング
      const tagBtns = document.querySelectorAll('.tag-btn');
      const workCards = document.querySelectorAll('.work-card');

      tagBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const selectedTag = this.getAttribute('data-tag');
          
          // アクティブタグの更新
          tagBtns.forEach(b => b.classList.remove('active'));
          this.classList.add('active');

          // カードの表示切り替え
          workCards.forEach(card => {
            const cardTags = card.getAttribute('data-tags').split(',');
            const shouldShow = selectedTag === 'all' || cardTags.includes(selectedTag);
            
            if (shouldShow) {
              card.classList.remove('hidden');
              card.classList.add('fadeInScale');
            } else {
              card.classList.add('hidden');
            }
          });
        });
      });
    });

doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Portfolio
    link(rel="stylesheet" href="/style.css")
    link(href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap" rel="stylesheet")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
  body
    header.site-header
      .container.header-inner
        h1.logo My Portfolio
        nav
          ul.nav-list
            li
              a(href="/#about")
                i.bi.bi-person-lines-fill
                |  About
            li
              a(href="/#skills")
                i.bi.bi-tools
                |  Skills
            li
              a(href="/#works")
                i.bi.bi-briefcase-fill
                |  Works
            li
              a(href="/#contact")
                i.bi.bi-envelope-fill
                |  Contact
            li
              a(href="/posts")
                i.bi.bi-chat-left-dots-fill
                |  Chat
    
    block content

    footer.site-footer
      .container
        .footer-flex-container
          .footer-left
            button.footer-icon-btn(type="button" id="tea-btn" aria-label="紅茶")
              i.bi.bi-cup-hot-fill.icon-tea
          p.footer-center &copy; 2025 My Portfolio.
          .footer-right
            button.btn.btn-darkmode(type="button" id="dark-mode-toggle") ダークモード
            button.btn.btn-hamburg(type="button" id="hamburg-btn") ハンバーグ

    div#chatbot-container.chatbot-container
      .chatbot-header
        h3 ポートフォリオについて質問
        button.chatbot-toggle#chatbot-toggle −
      .chatbot-messages#chatbot-messages
      .chatbot-templates
        button.template-btn(data-question="こんにちは") こんにちは
        button.template-btn(data-question="好きな食べ物は？") 好きな食べ物
        button.template-btn(data-question="授業の感想を教えてください") 授業の感想
        button.template-btn(data-question="現在の仕事は？") 仕事内容
      .chatbot-input-area
        input#chatbot-input(type="text" placeholder="質問を入力...")
        button#chatbot-send 送信

    button.chatbot-open-btn#chatbot-open-btn
      i.bi.bi-chat-left-dots-fill

    script(src="/bot.js")
    script(src="/utils.js")
